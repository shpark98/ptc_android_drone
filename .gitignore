# ---------------------------------------------------------------------------
# Archived / non-Android material (Python ML pipeline, model weights, phone
# captures, model-conversion scripts). Kept locally under archive/ but excluded
# from the Android-app handoff. See archive/README.md.
# ---------------------------------------------------------------------------
/archive/

# Build artifacts
/android/app/build/
/android/app/.cxx/
/android/.gradle/
/android/build/
/cpp/build/

# Model assets — large binaries, provided/downloaded separately (see
# android/BUILD.md). The app needs: depth_anything_v2.onnx + .data (QNN) and
# depth_anything.onnx (CPU fallback).
/android/app/src/main/assets/*.dlc
/android/app/src/main/assets/*.onnx
/android/app/src/main/assets/*.data
/android/app/src/main/assets/*.tflite
/android/app/src/main/assets/*.bin

# Gradle distribution (the wrapper downloads it automatically)
/android/gradle/wrapper/gradle-*.zip*

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IDE
.idea/
*.iml
.vscode/

# Android
local.properties
*.apk

# OS
.DS_Store
Thumbs.db
*~
*.swp

# Native build intermediates
*.o
*.a

# Bundled native dependencies — obtained via android/setup_libs.sh / QAIRT SDK
# (see android/BUILD.md), too large for git
/android/app/src/main/jniLibs/
/android/app/libs/eigen3/
/android/app/libs/arm64-v8a/
/android/app/libs/*.aar
/android/app/libs/*.jar

# OpenCV Android SDK (large, download via android/setup_libs.sh)
/android/opencv-android-sdk/

# Compile logs
compile_*.txt
