# ---------------------------------------------------------------------------
# Archived / non-Android material (Python ML pipeline, model weights, phone
# captures, model-conversion scripts). Kept locally under archive/ but excluded
# from the Android-app handoff. See archive/README.md.
# ---------------------------------------------------------------------------
/archive/

# Build artifacts
/android/app/build/
/android/app/.cxx/
/android/.gradle/
/android/build/
/cpp/build/

# Model assets — the 3 files the app actually loads (depth_anything_v2.onnx +
# .data, depth_anything.onnx) ARE committed so `git clone` is self-contained.
# Only the unused alternate formats stay out.
/android/app/src/main/assets/*.dlc
/android/app/src/main/assets/*.tflite
/android/app/src/main/assets/*.bin

# Gradle distribution (the wrapper downloads it automatically)
/android/gradle/wrapper/gradle-*.zip*

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# IDE
.idea/
*.iml
.vscode/

# Android
local.properties
*.apk

# OS
.DS_Store
Thumbs.db
*~
*.swp

# Native build intermediates
*.o
*.a

# Native deps are committed for a self-contained `git clone` (OpenCV trimmed to
# arm64-v8a, Eigen, QNN HTP libs). Only unused big AARs/JARs stay out —
# snpe-release.aar (71 MB) is not used by the ORT-QNN build path.
/android/app/src/main/jniLibs/
/android/app/libs/*.aar
/android/app/libs/*.jar

# Compile logs
compile_*.txt
